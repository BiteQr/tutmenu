{
  "name": "tutmenu",
  // Служебные адреса отдельных версий не нужны: меньше дверей мимо защиты админки
  "preview_urls": false,
  "compatibility_date": "2026-09-25",
  "main": "worker.js",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // видео из /media отдаёт worker.js — с Range-ответами, без них iPhone не играет видео
    "run_worker_first": ["/media/*", "/site/*", "/site", "/", "/index.html", "/robots.txt", "/sitemap.xml"]
  },

  // ЗАМЕНИ database_id на настоящий: Cloudflare Dashboard → D1 → база tutmenu →
  // вкладка Overview → поле "Database ID".
  "d1_databases": [
    { "binding": "DB", "database_name": "tutmenu", "database_id": "936a5fca-c65d-4bc9-82e7-f3dc5ebd2808" }
  ],

  // Workers AI — умный поиск блюд (/api/ai-search)
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["17 * * * *"] },
  "images": { "binding": "IMAGES" },

  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "tutmenu-files" }
  ]
}
